<div class="product-card public-card" 
     data-category="<%= product.category || 'all' %>" 
     data-product-id="<%= product.id %>"
     data-product-name="<%= product.name %>"
     data-product-price="<%= product.finalPrice || (typeof product.price === 'string' ? parseFloat(product.price) : product.price) %>"
     data-has-discount="<%= (product.discount && product.discount > 0) || (product.appliedDiscounts && product.appliedDiscounts.length > 0) ? 'true' : 'false' %>"
     data-discount-value="<%= product.discount || 0 %>">
  <div class="product-card-container">
    <% if (product.imageUrl) { %>
      <div class="product-image">
        <img src="<%= product.imageUrl %>" alt="<%= product.name %>">
      </div>
    <% } %>
    <% 
      const price = typeof product.price === 'string' ? parseFloat(product.price) : product.price;
      let discount = product.discount || 0;
      discount = typeof discount === 'string' ? parseInt(discount) : discount;
      const hasAppliedDiscounts = product.appliedDiscounts && product.appliedDiscounts.length > 0;
      const hasDiscount = (discount && discount > 0) || hasAppliedDiscounts;
    %>
    <% if ((discount && discount > 0) || hasAppliedDiscounts) { %>
      <div class="discount-badge"><%= discount > 0 ? discount + '% OFF' : 'SALE' %></div>
    <% } %>
    <h3><%= product.name %></h3>
    <p><%= product.description || 'No description' %></p>
    <% if (hasAppliedDiscounts) { %>
      <div class="discount-badges">
        <% product.appliedDiscounts.forEach(disc => { %>
          <span class="discount-tag"><%= disc.code %></span>
        <% }); %>
      </div>
    <% } %>
    <div class="price-container">
      <% if (hasDiscount) { %>
        <div class="price-info">
          <span class="original-price">$<%= price.toFixed(2) %></span>
          <span class="discounted-price">$<%= product.finalPrice || (price * (1 - discount / 100)).toFixed(2) %></span>
        </div>
      <% } else { %>
        <p><strong>$<%= price.toFixed(2) %></strong></p>
      <% } %>
    </div>
    <div class="product-actions">
      <a href="#" class="button learn-more">Learn More</a>
      <button class="button add-to-cart" data-product-id="<%= product.id %>" data-product-name="<%= product.name %>" data-product-price="<%= product.finalPrice || (discount && discount > 0 ? (price * (1 - discount / 100)).toFixed(2) : price.toFixed(2)) %>">
        Add to Cart
      </button>
      <a href="https://wa.me/1234567890?text=Hi%2C%20I%20am%20interested%20in%20<%= encodeURIComponent(product.name) %>" class="button whatsapp" target="_blank" title="Ask on WhatsApp">
        💬 WhatsApp
      </a>
    </div>
  </div>
</div>

<style>
.product-card-container {
  position: relative;
}
.product-image {
  width: 100%;
  height: 200px;
  background: #ffffff;
  border-radius: 4px;
  overflow: hidden;
  margin-bottom: 1rem;
}
.product-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.discount-badge {
  position: absolute;
  top: 10px;
  right: 10px;
  background: #e74c3c;
  color: white;
  padding: 0.5rem 0.75rem;
  border-radius: 4px;
  font-weight: bold;
  font-size: 0.85rem;
  z-index: 10;
}
.discount-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin: 0.5rem 0;
}
.discount-tag {
  display: inline-block;
  background: #3498db;
  color: white;
  padding: 0.25rem 0.5rem;
  border-radius: 3px;
  font-size: 0.85rem;
  font-weight: 600;
}
.price-container {
  margin: 0.5rem 0;
}
.price-info {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}
.original-price {
  text-decoration: line-through;
  color: #7f8c8d;
  font-size: 0.9rem;
}
.discounted-price {
  font-size: 1.2rem;
  font-weight: bold;
  color: #e74c3c;
}
.product-actions {
  display: flex;
  gap: 0.5rem;
  margin-top: 1rem;
  flex-wrap: wrap;
}
.button {
  flex: 1;
  min-width: 80px;
  padding: 0.5rem;
  text-align: center;
  border: none;
  border-radius: 4px;
  background: #3498db;
  color: white;
  cursor: pointer;
  text-decoration: none;
  display: block;
  font-size: 0.9rem;
}
.button:hover {
  background: #2980b9;
}
.button.whatsapp {
  background: #25d366;
  flex: 0 1 auto;
}
.button.whatsapp:hover {
  background: #1ea952;
}
.learn-more {
  display: flex;
  align-items: center;
  justify-content: center;
}
</style>