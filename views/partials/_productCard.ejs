<%
  const price = typeof product.price === 'string' ? parseFloat(product.price) : product.price;
  let discount = product.discount || 0;
  discount = typeof discount === 'string' ? parseInt(discount, 10) : discount;
  const hasAppliedDiscounts = product.appliedDiscounts && product.appliedDiscounts.length > 0;
  const hasDiscount = (discount && discount > 0) || hasAppliedDiscounts;
  const finalPrice = product.finalPrice || (hasDiscount ? (price * (1 - (discount || 0) / 100)).toFixed(2) : price.toFixed(2));
%>

<article class="product-card fade-in"
         data-category="<%= product.category || 'all' %>"
         data-product-id="<%= product.id %>"
         data-product-name="<%= product.name %>"
         data-product-price="<%= finalPrice %>"
         data-has-discount="<%= hasDiscount ? 'true' : 'false' %>"
         data-discount-value="<%= discount || 0 %>"
         aria-label="<%= product.name %> product card">
  <div class="product-card-header">
    <% if (product.imageUrl) { %>
      <div class="product-card-image" aria-hidden="true">
        <img src="<%= product.imageUrl %>" alt="<%= product.name %> image">
      </div>
    <% } %>
    <div class="product-card-body">
      <h3 class="product-card-title"><%= product.name %></h3>
      <p class="product-card-description"><%= product.description || 'No description' %></p>

      <% if (hasAppliedDiscounts) { %>
        <div class="product-meta" aria-label="Applied discount codes">
          <% product.appliedDiscounts.forEach(disc => { %>
            <span class="badge-pill badge-code"><%= disc.code %></span>
          <% }); %>
        </div>
      <% } %>

      <div class="product-pricing" aria-label="Pricing information">
        <% if (hasDiscount) { %>
          <span class="price-original">$<%= price.toFixed(2) %></span>
          <span class="price-final">$<%= finalPrice %></span>
        <% } else { %>
          <span class="price-final">$<%= price.toFixed(2) %></span>
        <% } %>
      </div>

      <%- include('./_discountBadges', { product, compact: false }) %>
    </div>
  </div>

  <% if (hasDiscount) { %>
    <span class="discount-flag" aria-label="On sale">
      <%= discount && discount > 0 ? `${discount}% OFF` : 'SALE' %>
    </span>
  <% } %>

  <div class="product-card-actions">
    <button type="button"
            class="btn btn-outline learn-more"
            data-role="learn-more"
            aria-label="Learn more about <%= product.name %>">
      Learn More
    </button>
    <button type="button"
            class="btn btn-primary add-to-cart"
            data-product-id="<%= product.id %>"
            data-product-name="<%= product.name %>"
            data-product-price="<%= finalPrice %>"
            aria-label="Add <%= product.name %> to cart">
      Add to Cart
    </button>
    <a href="https://wa.me/1234567890?text=Hi%2C%20I%20am%20interested%20in%20<%= encodeURIComponent(product.name) %>"
       class="btn btn-whatsapp"
       target="_blank"
       rel="noopener noreferrer"
       aria-label="Ask about <%= product.name %> on WhatsApp">
      💬 WhatsApp
    </a>
  </div>
</article>
