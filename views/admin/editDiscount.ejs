<div class="admin-content">
  <div class="content-header">
    <h1>Edit Discount</h1>
    <a href="/admin/discounts" class="btn btn-secondary">← Back to Discounts</a>
  </div>

  <form method="POST" action="/admin/discounts/<%= discount.id %>/edit" class="discount-form">
    <div class="form-section">
      <h2>Basic Information</h2>

      <div class="form-group">
        <label for="name">Discount Name *</label>
        <input type="text" id="name" name="name" required placeholder="e.g., Summer Sale" value="<%= discount.name %>">
      </div>

      <div class="form-group">
        <label for="code">Discount Code *</label>
        <input type="text" id="code" name="code" required placeholder="e.g., SUMMER20" value="<%= discount.code %>">
      </div>

      <div class="form-group">
        <label for="description">Description</label>
        <textarea id="description" name="description" placeholder="Enter discount description" rows="3"><%= discount.description || '' %></textarea>
      </div>
    </div>

    <div class="form-section">
      <h2>Discount Details</h2>

      <div class="form-row">
        <div class="form-group">
          <label for="type">Type *</label>
          <select id="type" name="type" required>
            <option value="percentage" <%= discount.type === 'percentage' ? 'selected' : '' %>>Percentage (%)</option>
            <option value="fixed" <%= discount.type === 'fixed' ? 'selected' : '' %>>Fixed Amount ($)</option>
          </select>
        </div>

        <div class="form-group">
          <label for="value">Value *</label>
          <input type="number" id="value" name="value" required placeholder="0" step="0.01" min="0" value="<%= discount.value %>">
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label for="maxUses">Max Uses (optional)</label>
          <input type="number" id="maxUses" name="maxUses" placeholder="Leave empty for unlimited" min="1" value="<%= discount.maxUses || '' %>">
        </div>

        <div class="form-group">
          <label for="expiryDate">Expiry Date (optional)</label>
          <input type="date" id="expiryDate" name="expiryDate" value="<%= discount.expiryDate ? new Date(discount.expiryDate).toISOString().split('T')[0] : '' %>">
        </div>
      </div>
    </div>

    <div class="form-section">
      <h2>Usage Statistics</h2>

      <div class="stats-row">
        <div class="stat-box">
          <label>Current Uses</label>
          <p class="stat-value"><%= discount.currentUses || 0 %></p>
        </div>
        <% if (discount.maxUses) { %>
          <div class="stat-box">
            <label>Max Uses</label>
            <p class="stat-value"><%= discount.maxUses %></p>
          </div>
          <div class="stat-box">
            <label>Remaining</label>
            <p class="stat-value"><%= discount.maxUses - (discount.currentUses || 0) %></p>
          </div>
        <% } %>
      </div>
    </div>

    <div class="form-section">
      <h2>Status</h2>

      <div class="form-group checkbox">
        <input type="checkbox" id="active" name="active" value="on" <%= discount.active ? 'checked' : '' %>>
        <label for="active">Active</label>
      </div>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Update Discount</button>
      <a href="/admin/discounts" class="btn btn-secondary">Cancel</a>
    </div>
  </form>
</div>

<style>
