<h2>Change Password</h2>

<% if (error) { %>
  <div class="alert alert-error">
    <strong>✗ Error:</strong> <%= error %>
  </div>
<% } %>

<% if (success) { %>
  <div class="alert alert-success">
    <strong>✓ Success:</strong> <%= success %>
  </div>
<% } %>

<form action="/admin/changePassword" method="POST">
  <div class="form-group">
    <label for="currentPassword">Current Password:</label>
    <input type="password" id="currentPassword" name="currentPassword" required autofocus>
  </div>

  <div class="form-group">
    <label for="newPassword">New Password:</label>
    <input type="password" id="newPassword" name="newPassword" required>
    <small style="color: #666;">Requirements:<br>• Minimum 8 characters<br>• At least 1 uppercase letter<br>• At least 1 lowercase letter<br>• At least 1 number<br>• At least 1 special character (!@#$%^&*)</small>
  </div>

  <div class="form-group">
    <label for="confirmPassword">Confirm New Password:</label>
    <input type="password" id="confirmPassword" name="confirmPassword" required>
  </div>

  <div class="form-actions">
    <button type="submit" class="btn-primary">Change Password</button>
    <a href="/admin/dashboard" class="btn-secondary">Cancel</a>
  </div>
</form>

<style>
.form-group {
  margin-bottom: 1.5rem;
}

label {
  display: block;
  margin-bottom: 0.5rem;
  font-weight: 600;
  color: #2c3e50;
}

input[type="password"] {
  width: 100%;
  max-width: 400px;
  padding: 0.75rem;
  border: 1px solid #ccc;
  border-radius: 4px;
  font-size: 1rem;
  box-sizing: border-box;
}

input[type="password"]:focus {
  border-color: #3498db;
  outline: none;
  box-shadow: 0 0 5px rgba(52, 152, 219, 0.3);
}

small {
  display: block;
  margin-top: 0.5rem;
  font-size: 0.85rem;
  color: #7f8c8d;
}

.form-actions {
  display: flex;
  gap: 1rem;
  margin-top: 2rem;
}

.btn-primary, .btn-secondary {
  padding: 0.75rem 1.5rem;
  border: none;
  border-radius: 4px;
  font-size: 1rem;
  cursor: pointer;
  font-weight: 600;
  text-decoration: none;
  display: inline-block;
}

.btn-primary {
  background: #28a745;
  color: white;
}

.btn-primary:hover {
  background: #218838;
}

.btn-secondary {
  background: #6c757d;
  color: white;
  text-align: center;
}

.btn-secondary:hover {
  background: #5a6268;
}

.alert {
  padding: 1rem;
  border-radius: 4px;
  margin-bottom: 1.5rem;
  border-left: 4px solid;
}

.alert-error {
  background: #f8d7da;
  color: #721c24;
  border-left-color: #f5c6cb;
}

.alert-success {
  background: #d4edda;
  color: #155724;
  border-left-color: #c3e6cb;
}

.alert strong {
  display: block;
  margin-bottom: 0.25rem;
}

@media (max-width: 768px) {
  .form-actions {
    flex-direction: column;
  }
  
  button, .btn {
    width: 100%;
  }
}
</style>

<script>
// Real-time password strength indicator
document.getElementById('newPassword')?.addEventListener('input', (e) => {
  const password = e.target.value;
  const strengthEl = document.getElementById('passwordStrength');
  
  let checks = {
    length: password.length >= 8,
    uppercase: /[A-Z]/.test(password),
    lowercase: /[a-z]/.test(password),
    number: /[0-9]/.test(password),
    special: /[!@#$%^&*()_+\-=\[\]{};':"\\|,.<>\/?]/.test(password)
  };
  
  const passedChecks = Object.values(checks).filter(Boolean).length;
  let strength = '';
  let color = '';
  
  if (password.length === 0) {
    strength = '';
  } else if (passedChecks < 3) {
    strength = 'Weak password';
    color = '#e74c3c';
  } else if (passedChecks < 5) {
    strength = 'Good password';
    color = '#f39c12';
  } else {
    strength = 'Strong password ✓';
    color = '#27ae60';
  }
  
  strengthEl.textContent = strength;
  strengthEl.style.color = color;
});
</script>