<h2>Contact Messages</h2>
<table>
  <thead>
    <tr>
      <th>Name</th>
      <th>Email</th>
      <th>Message</th>
      <th>Date</th>
    </tr>
  </thead>
  <tbody>
    <% messages.forEach(message => { %>
      <tr>
        <td><%= message.name %></td>
        <td><%= message.email %></td>
        <td><%= message.message %></td>
        <td><%= new Date(message.createdAt.seconds * 1000).toLocaleDateString() %></td>
      </tr>
    <% }); %>
  </tbody>
</table>